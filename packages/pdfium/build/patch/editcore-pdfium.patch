+RetainPtr<CPDF_Dictionary> ViewportPageDict(FPDF_DOCUMENT document,
+                                            int page_index) {
+  CPDF_Document* doc = CPDFDocumentFromFPDFDocument(document);
+  if (!doc || page_index < 0 || page_index >= doc->GetPageCount()) {
+    return nullptr;
+  }
+  return doc->GetMutablePageDictionary(page_index);
+}
+
+RetainPtr<CPDF_Array> OwnedViewports(CPDF_Dictionary* page) {
+  RetainPtr<CPDF_Array> vp = page->GetMutableArrayFor("VP");
+  if (!vp) {
+    return nullptr;
+  }
+  RetainPtr<const CPDF_Object> raw = page->GetObjectFor("VP");
+  if (raw && raw->IsReference()) {
+    RetainPtr<CPDF_Array> copy = ToArray(vp->Clone());
+    if (!copy) {
+      return nullptr;
+    }
+    page->SetFor("VP", copy);
+    vp = std::move(copy);
+  }
+  return vp;
+}
+
+void ViewportJson(const CPDF_Dictionary* vd,
+                  size_t index,
+                  fxcrt::ostringstream& out) {
+  out << "{\"i\":" << index;
+  if (vd) {
+    RetainPtr<const CPDF_Array> bbox = vd->GetArrayFor("BBox");
+    if (bbox && bbox->size() == 4) {
+      out << ",\"BBox\":[";
+      for (size_t k = 0; k < 4; ++k) {
+        const float v = bbox->GetFloatAt(k);
+        out << (k ? "," : "") << (std::isfinite(v) ? v : 0.0f);
+      }
+      out << "]";
+    }
+    if (vd->KeyExist("Name")) {
+      out << ",\"Name\":" << JsonEscape(vd->GetUnicodeTextFor("Name").ToUTF8());
+    }
+    if (vd->KeyExist("PtData")) {
+      out << ",\"PtData\":true";
+    }
+    RetainPtr<const CPDF_Dictionary> measure = vd->GetDictFor("Measure");
+    if (measure) {
+      out << ",\"Measure\":" << MeasureDictJson(measure.Get());
+    }
+  }
+  out << "}";
+}
+
+unsigned long CopyOutText(const ByteString& text,
+                          char* buffer,
+                          unsigned long buflen) {
+  const unsigned long need = static_cast<unsigned long>(text.GetLength()) + 1;
+  if (buffer && buflen >= need) {
+    memcpy(buffer, text.c_str(), need);
+  }
+  return need;
+}
