+bool CPDF_TextObject::SetAbsolutePositions(
+    pdfium::span<const float> absolute_positions) {
+  std::vector<uint32_t> real_codes;
+  real_codes.reserve(char_codes_.size());
+  for (uint32_t code : char_codes_) {
+    if (code != CPDF_Font::kInvalidCharCode) {
+      real_codes.push_back(code);
+    }
+  }
+  if (real_codes.size() <= 1) {
+    return false;
+  }
+  if (absolute_positions.size() != real_codes.size() - 1) {
+    return false;
+  }
+
+  const float fontsize = GetFontSize();
+  if (fontsize == 0.0f) {
+    return false;
+  }
+
+  RetainPtr<CPDF_Font> font = GetFont();
+  const CPDF_CIDFont* cid_font = font->AsCIDFont();
+  const float char_space = text_state().GetCharSpace();
+  const float word_space = text_state().GetWordSpace();
+
+  std::vector<ByteString> strings(real_codes.size());
+  std::vector<float> kernings(real_codes.size() - 1);
+  float current_position = 0;
+  for (size_t i = 0; i + 1 < real_codes.size(); ++i) {
+    const uint32_t charcode = real_codes[i];
+    font->AppendChar(&strings[i], charcode);
+    current_position += GetCharWidth(charcode);
+    if (charcode == ' ' && (!cid_font || cid_font->GetCharSize(' ') == 1)) {
+      current_position += word_space;
+    }
+    current_position += char_space;
+    kernings[i] = (current_position - absolute_positions[i]) * 1000 / fontsize;
+    current_position = absolute_positions[i];
+  }
+  font->AppendChar(&strings.back(), real_codes.back());
+  SetSegments(strings, kernings);
+  CalcPositionDataInternal(font);
+  return true;
+}
+
