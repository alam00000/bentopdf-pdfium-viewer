+                                int x_count,
+                                const EPDFNumberFormat* y_arr,
+                                int y_count,
+                                const EPDFNumberFormat* d_arr,
+                                int d_count,
+                                const EPDFNumberFormat* a_arr,
+                                int a_count,
+                                float cyx) {
+  if (!annot) return false;
+
+  RetainPtr<CPDF_Dictionary> annot_dict =
+      GetMutableAnnotDictFromFPDFAnnotation(annot);
+  if (!annot_dict) return false;
