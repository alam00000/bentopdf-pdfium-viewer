+enum class BentoMarkupAxis { kHorizontal = 0, kVerticalRight = 1, kVerticalLeft = 2 };
+
+BentoMarkupAxis ResolveBentoMarkupAxis(const CPDF_Dictionary* annot_dict,
+                                       const CFX_FloatRect& rect) {
+  const int ori = annot_dict->GetIntegerFor("EPDF:MarkupOri");
+  if (ori >= 1) {
+    if (ori == 2) {
+      return BentoMarkupAxis::kVerticalRight;
+    }
+    if (ori == 3) {
+      return BentoMarkupAxis::kVerticalLeft;
+    }
+    return BentoMarkupAxis::kHorizontal;
+  }
+  int page_rot = annot_dict->GetIntegerFor("EPDFPageRot");
+  page_rot = ((page_rot % 4) + 4) % 4;
+  if (page_rot == 1) {
+    return BentoMarkupAxis::kVerticalRight;
+  }
+  if (page_rot == 3) {
+    return BentoMarkupAxis::kVerticalLeft;
+  }
+  (void)rect;
+  return BentoMarkupAxis::kHorizontal;
+}
