+void FlattenBezier(const CFX_PointF& p0,
+                   const CFX_PointF& p1,
+                   const CFX_PointF& p2,
+                   const CFX_PointF& p3,
+                   std::vector<CFX_PointF>& out,
+                   int depth) {
+  if (depth >= 6) {
+    out.push_back(p3);
+    return;
+  }
+  const float dx = p3.x - p0.x;
+  const float dy = p3.y - p0.y;
+  const float chord_len_sq = dx * dx + dy * dy;
+  if (chord_len_sq < 0.25f) {
+    out.push_back(p3);
+    return;
+  }
+  const float chord_len = std::sqrt(chord_len_sq);
+  const float d1 = std::fabs((p1.x - p0.x) * dy - (p1.y - p0.y) * dx);
+  const float d2 = std::fabs((p2.x - p0.x) * dy - (p2.y - p0.y) * dx);
+  if (d1 + d2 <= 0.5f * chord_len) {
+    out.push_back(p3);
+    return;
+  }
+  const CFX_PointF p01{(p0.x + p1.x) * 0.5f, (p0.y + p1.y) * 0.5f};
+  const CFX_PointF p12{(p1.x + p2.x) * 0.5f, (p1.y + p2.y) * 0.5f};
+  const CFX_PointF p23{(p2.x + p3.x) * 0.5f, (p2.y + p3.y) * 0.5f};
+  const CFX_PointF p012{(p01.x + p12.x) * 0.5f, (p01.y + p12.y) * 0.5f};
+  const CFX_PointF p123{(p12.x + p23.x) * 0.5f, (p12.y + p23.y) * 0.5f};
+  const CFX_PointF p0123{(p012.x + p123.x) * 0.5f, (p012.y + p123.y) * 0.5f};
+  FlattenBezier(p0, p01, p012, p0123, out, depth + 1);
+  FlattenBezier(p0123, p123, p23, p3, out, depth + 1);
+}
+
+struct SnapEmitState {
+  std::vector<EPDF_PathSegment>* out;
+  size_t total_count;
+  int max_count;
+  float qx0, qy0, qx1, qy1;
+  int next_path_id;
+};
+
+bool SegmentIntersectsQuery(const SnapEmitState& s,
+                            float x0, float y0,
+                            float x1, float y1) {
+  const float lo_x = x0 < x1 ? x0 : x1;
+  const float hi_x = x0 < x1 ? x1 : x0;
+  const float lo_y = y0 < y1 ? y0 : y1;
+  const float hi_y = y0 < y1 ? y1 : y0;
+  if (hi_x < s.qx0 || lo_x > s.qx1) return false;
+  if (hi_y < s.qy0 || lo_y > s.qy1) return false;
+  return true;
+}
+
+void EmitSegment(SnapEmitState& s,
+                 float x0, float y0,
+                 float x1, float y1,
+                 int path_id,
+                 int subpath_id,
+                 unsigned int flags) {
+  if (x0 == x1 && y0 == y1) return;
+  if (!SegmentIntersectsQuery(s, x0, y0, x1, y1)) return;
+  s.total_count++;
+  if (!s.out) return;
+  if (static_cast<int>(s.out->size()) >= s.max_count) return;
+  s.out->push_back(EPDF_PathSegment{x0, y0, x1, y1, path_id, subpath_id,
+                                    flags});
+}
+
+void WalkPathObject(SnapEmitState& s,
+                    const CPDF_PathObject& path_obj,
+                    const CFX_Matrix& parent_ctm,
+                    int path_id) {
+  CFX_Matrix ctm = path_obj.matrix();
+  ctm.Concat(parent_ctm);
+
+  unsigned int paint_flags = 0;
+  if (path_obj.stroke()) paint_flags |= EPDF_PATHSEG_STROKED;
+  if (!path_obj.has_no_filltype()) paint_flags |= EPDF_PATHSEG_FILLED;
+
+  const std::vector<CFX_Path::Point>& points = path_obj.path().GetPoints();
+  if (points.empty()) return;
+
+  CFX_PointF subpath_start{};
+  CFX_PointF current{};
+  bool have_current = false;
+  int subpath_id = -1;
+
+  for (size_t i = 0; i < points.size(); ++i) {
+    const CFX_Path::Point& pt = points[i];
+    switch (pt.type_) {
+      case CFX_Path::Point::Type::kMove: {
+        current = ctm.Transform(pt.point_);
+        subpath_start = current;
+        subpath_id++;
+        have_current = true;
+        break;
+      }
+      case CFX_Path::Point::Type::kLine: {
+        if (have_current) {
+          const CFX_PointF end = ctm.Transform(pt.point_);
+          EmitSegment(s, current.x, current.y, end.x, end.y,
+                      path_id, subpath_id, paint_flags);
+          current = end;
+        }
+        if (pt.close_figure_ && have_current) {
+          EmitSegment(s, current.x, current.y,
+                      subpath_start.x, subpath_start.y,
+                      path_id, subpath_id,
+                      paint_flags | EPDF_PATHSEG_CLOSING);
+          current = subpath_start;
+        }
+        break;
+      }
+      case CFX_Path::Point::Type::kBezier: {
+        if (i + 2 >= points.size()) {
+          return;
+        }
+        const CFX_PointF p0 = current;
+        const CFX_PointF p1 = ctm.Transform(points[i].point_);
+        const CFX_PointF p2 = ctm.Transform(points[i + 1].point_);
+        const CFX_PointF p3 = ctm.Transform(points[i + 2].point_);
+        std::vector<CFX_PointF> flat;
+        flat.reserve(8);
+        FlattenBezier(p0, p1, p2, p3, flat, 0);
+        CFX_PointF prev = p0;
+        for (const CFX_PointF& q : flat) {
+          EmitSegment(s, prev.x, prev.y, q.x, q.y,
+                      path_id, subpath_id,
+                      paint_flags | EPDF_PATHSEG_CURVE);
+          prev = q;
+        }
+        current = p3;
+        if (points[i + 2].close_figure_) {
+          EmitSegment(s, current.x, current.y,
+                      subpath_start.x, subpath_start.y,
+                      path_id, subpath_id,
+                      paint_flags | EPDF_PATHSEG_CLOSING);
+          current = subpath_start;
+        }
+        i += 2;
+        break;
+      }
+    }
+  }
+}
+
+void WalkHolder(SnapEmitState& s,
+                const CPDF_PageObjectHolder& holder,
+                const CFX_Matrix& parent_ctm);
+
+void WalkFormObject(SnapEmitState& s,
+                    const CPDF_FormObject& form_obj,
+                    const CFX_Matrix& parent_ctm) {
+  CFX_Matrix ctm = form_obj.form_matrix();
+  ctm.Concat(parent_ctm);
+  const CPDF_Form* form = form_obj.form();
+  if (!form) return;
+  WalkHolder(s, *form, ctm);
+}
+
+void WalkHolder(SnapEmitState& s,
+                const CPDF_PageObjectHolder& holder,
+                const CFX_Matrix& parent_ctm) {
+  for (auto it = holder.begin(); it != holder.end(); ++it) {
+    const CPDF_PageObject* obj = it->get();
+    if (!obj) continue;
+    if (obj->IsPath()) {
+      const CPDF_PathObject* p = obj->AsPath();
+      if (p) {
+        const int id = s.next_path_id++;
+        WalkPathObject(s, *p, parent_ctm, id);
+      }
+    } else if (obj->IsForm()) {
+      const CPDF_FormObject* f = obj->AsForm();
+      if (f) {
+        WalkFormObject(s, *f, parent_ctm);
+      }
+    }
+  }
+}
+
+}
+
+FPDF_EXPORT int FPDF_CALLCONV
+EPDFPage_GetPathSegments(FPDF_PAGE page,
+                         float query_x_min,
+                         float query_y_min,
+                         float query_x_max,
+                         float query_y_max,
+                         EPDF_PathSegment* out_buffer,
+                         int max_count) {
+  CPDF_Page* p = CPDFPageFromFPDFPage(page);
+  if (!p) return -1;
+
+  std::vector<EPDF_PathSegment> buf;
+  if (out_buffer && max_count > 0) {
+    buf.reserve(static_cast<size_t>(max_count));
+  }
+  SnapEmitState s{
+      out_buffer ? &buf : nullptr,
+      0,
+      out_buffer ? max_count : 0,
+      std::min(query_x_min, query_x_max),
+      std::min(query_y_min, query_y_max),
+      std::max(query_x_min, query_x_max),
+      std::max(query_y_min, query_y_max),
+      0,
+  };
+  CFX_Matrix identity;
+  WalkHolder(s, *p, identity);
+
+  if (out_buffer && max_count > 0) {
+    const int copy_count = std::min(static_cast<int>(buf.size()), max_count);
+    for (int i = 0; i < copy_count; ++i) {
+      out_buffer[i] = buf[i];
+    }
+  }
+  return static_cast<int>(s.total_count);
+}
