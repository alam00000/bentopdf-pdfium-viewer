+struct BentoPageRotFrame {
+  bool active = false;
+  int quarter = 0;
+  CFX_FloatRect base;
+  CFX_FloatRect local_bbox;
+  CFX_Matrix matrix;
+
+  CFX_PointF ToLocal(const CFX_PointF& p) const {
+    switch (quarter) {
+      case 1:
+        return CFX_PointF(p.y - base.bottom, base.right - p.x);
+      case 2:
+        return CFX_PointF(base.right - p.x, base.top - p.y);
+      case 3:
+        return CFX_PointF(base.top - p.y, p.x - base.left);
+      default:
+        return p;
+    }
+  }
+
+  CFX_FloatRect RectToLocal(const CFX_FloatRect& r) const {
+    const CFX_PointF p0 = ToLocal(CFX_PointF(r.left, r.bottom));
+    const CFX_PointF p1 = ToLocal(CFX_PointF(r.right, r.top));
+    CFX_FloatRect out(p0.x, p0.y, p1.x, p1.y);
+    out.Normalize();
+    return out;
+  }
+};
+
+BentoPageRotFrame BentoGetPageRotFrame(const CPDF_Dictionary* annot_dict,
+                                       const CFX_FloatRect& base_rect) {
+  BentoPageRotFrame f;
+  int q = annot_dict->GetIntegerFor("EPDFPageRot");
+  q = ((q % 4) + 4) % 4;
+  if (q == 0) {
+    return f;
+  }
+  f.active = true;
+  f.quarter = q;
+  f.base = base_rect;
+  f.base.Normalize();
+  const float w = f.base.Width();
+  const float h = f.base.Height();
+  f.local_bbox =
+      (q == 2) ? CFX_FloatRect(0, 0, w, h) : CFX_FloatRect(0, 0, h, w);
+  switch (q) {
+    case 1:
+      f.matrix = CFX_Matrix(0, 1, -1, 0, f.base.right, f.base.bottom);
+      break;
+    case 2:
+      f.matrix = CFX_Matrix(-1, 0, 0, -1, f.base.right, f.base.top);
+      break;
+    case 3:
+      f.matrix = CFX_Matrix(0, -1, 1, 0, f.base.left, f.base.top);
+      break;
+  }
+  return f;
+}
