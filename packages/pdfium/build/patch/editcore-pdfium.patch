+FPDF_EXPORT int FPDF_CALLCONV
+EPDFDoc_SetPageViewport(FPDF_DOCUMENT document,
+                        int page_index,
+                        int index,
+                        float left,
+                        float bottom,
+                        float right,
+                        float top,
+                        FPDF_WIDESTRING name,
+                        const char* scale_ratio_utf8,
+                        const EPDFNumberFormat* x_arr,
+                        int x_count,
+                        const EPDFNumberFormat* y_arr,
+                        int y_count,
+                        const EPDFNumberFormat* d_arr,
+                        int d_count,
+                        const EPDFNumberFormat* a_arr,
+                        int a_count,
+                        float cyx) {
+  RetainPtr<CPDF_Dictionary> page = ViewportPageDict(document, page_index);
+  if (!page) {
+    return -1;
+  }
+  if (!std::isfinite(left) || !std::isfinite(bottom) ||
+      !std::isfinite(right) || !std::isfinite(top) || right <= left ||
+      top <= bottom) {
+    return -1;
+  }
+  RetainPtr<CPDF_Array> vp = OwnedViewports(page.Get());
+  const size_t size = vp ? vp->size() : 0;
+  if (index < -1 || (index >= 0 && static_cast<size_t>(index) >= size)) {
+    return -1;
+  }
+
+  RetainPtr<CPDF_Dictionary> vd;
+  if (index >= 0) {
+    RetainPtr<const CPDF_Dictionary> old = vp->GetDictAt(index);
+    if (old) {
+      vd = ToDictionary(old->Clone());
+    }
+  }
+  if (!vd) {
+    vd = pdfium::MakeRetain<CPDF_Dictionary>();
+  }
+  vd->SetNewFor<CPDF_Name>("Type", "Viewport");
+  auto bbox = vd->SetNewFor<CPDF_Array>("BBox");
+  bbox->AppendNew<CPDF_Number>(left);
+  bbox->AppendNew<CPDF_Number>(bottom);
+  bbox->AppendNew<CPDF_Number>(right);
+  bbox->AppendNew<CPDF_Number>(top);
+
+  WideString name_text =
+      name ? WideStringFromFPDFWideString(name) : WideString();
+  if (name_text.IsEmpty()) {
+    vd->RemoveFor("Name");
+  } else {
+    vd->SetNewFor<CPDF_String>("Name", name_text.AsStringView());
+  }
+
+  if (x_count > 0 && x_arr) {
+    vd->SetFor("Measure", BuildRectilinearMeasure(
+                              scale_ratio_utf8, x_arr, x_count, y_arr,
+                              y_count, d_arr, d_count, a_arr, a_count, cyx));
+  } else if (x_count == 0) {
+    vd->RemoveFor("Measure");
+  }
+
+  if (!vp) {
+    vp = page->SetNewFor<CPDF_Array>("VP");
+  }
+  if (index < 0) {
+    vp->Append(vd);
+    return static_cast<int>(vp->size() - 1);
+  }
+  vp->SetAt(index, vd);
+  return index;
+}
+
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+EPDFDoc_RemovePageViewport(FPDF_DOCUMENT document, int page_index, int index) {
+  RetainPtr<CPDF_Dictionary> page = ViewportPageDict(document, page_index);
+  if (!page) {
+    return false;
+  }
+  RetainPtr<CPDF_Array> vp = OwnedViewports(page.Get());
+  if (!vp || index < 0 || static_cast<size_t>(index) >= vp->size()) {
+    return false;
+  }
+  vp->RemoveAt(index);
+  if (vp->IsEmpty()) {
+    page->RemoveFor("VP");
+  }
+  return true;
+}
+
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+EPDFDoc_MovePageViewport(FPDF_DOCUMENT document,
+                         int page_index,
+                         int from,
+                         int to) {
+  RetainPtr<CPDF_Dictionary> page = ViewportPageDict(document, page_index);
+  if (!page) {
+    return false;
+  }
+  RetainPtr<CPDF_Array> vp = OwnedViewports(page.Get());
+  if (!vp || from < 0 || to < 0 || static_cast<size_t>(from) >= vp->size() ||
+      static_cast<size_t>(to) >= vp->size()) {
+    return false;
+  }
+  if (from == to) {
+    return true;
+  }
+  RetainPtr<CPDF_Object> entry = vp->GetMutableObjectAt(from);
+  if (!entry) {
+    return false;
+  }
+  vp->RemoveAt(from);
+  vp->InsertAt(to, std::move(entry));
+  return true;
+}
+
+FPDF_EXPORT int FPDF_CALLCONV
+EPDFDoc_CopyPageViewport(FPDF_DOCUMENT document,
+                         int from_page,
+                         int index,
+                         int to_page) {
+  RetainPtr<CPDF_Dictionary> src = ViewportPageDict(document, from_page);
+  RetainPtr<CPDF_Dictionary> dst = ViewportPageDict(document, to_page);
+  if (!src || !dst || index < 0) {
+    return -1;
+  }
+  RetainPtr<const CPDF_Array> svp = src->GetArrayFor("VP");
+  if (!svp || static_cast<size_t>(index) >= svp->size()) {
+    return -1;
+  }
+  RetainPtr<const CPDF_Dictionary> vd = svp->GetDictAt(index);
+  if (!vd) {
+    return -1;
+  }
+  RetainPtr<CPDF_Dictionary> copy = ToDictionary(vd->CloneDirectObject());
+  if (!copy) {
+    return -1;
+  }
+  RetainPtr<CPDF_Array> dvp = OwnedViewports(dst.Get());
+  if (!dvp) {
+    dvp = dst->SetNewFor<CPDF_Array>("VP");
+  }
+  dvp->Append(std::move(copy));
+  return static_cast<int>(dvp->size() - 1);
+}
+
+FPDF_EXPORT unsigned long FPDF_CALLCONV
+EPDFDoc_GetPageViewportsSyntax(FPDF_DOCUMENT document,
+                               int page_index,
+                               char* buffer,
+                               unsigned long buflen) {
+  RetainPtr<CPDF_Dictionary> page = ViewportPageDict(document, page_index);
+  if (!page) {
+    return 0;
+  }
+  ByteString text;
+  RetainPtr<const CPDF_Array> vp = page->GetArrayFor("VP");
+  if (vp) {
+    fxcrt::ostringstream out;
+    out << vp->CloneDirectObject().Get();
+    text = ByteString(out);
+  }
+  return CopyOutText(text, buffer, buflen);
+}
+
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+EPDFDoc_SetPageViewportsSyntax(FPDF_DOCUMENT document,
+                               int page_index,
+                               const char* syntax) {
+  CPDF_Document* doc = CPDFDocumentFromFPDFDocument(document);
+  RetainPtr<CPDF_Dictionary> page = ViewportPageDict(document, page_index);
+  if (!doc || !page) {
+    return false;
+  }
+  if (!syntax || !*syntax) {
+    page->RemoveFor("VP");
+    return true;
+  }
+  const size_t len = strlen(syntax);
+  auto stream = pdfium::MakeRetain<CFX_MemoryStream>();
+  stream->WriteBlock(pdfium::span<const uint8_t>(
+      reinterpret_cast<const uint8_t*>(syntax), len));
+  CPDF_SyntaxParser parser(stream);
+  RetainPtr<CPDF_Object> parsed = parser.GetObjectBody(doc);
+  if (!parsed || !parsed->IsArray()) {
+    return false;
+  }
+  page->SetFor("VP", std::move(parsed));
+  return true;
+}
+
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+EPDFAnnot_SetCaptionOffset(FPDF_ANNOTATION annot, float dx, float dy) {
+  if (!annot) return false;
+  RetainPtr<CPDF_Dictionary> dict =
+      GetMutableAnnotDictFromFPDFAnnotation(annot);
+  if (!dict) return false;
+
+  FPDF_ANNOTATION_SUBTYPE subtype = FPDFAnnot_GetSubtype(annot);
+  const char* key = (subtype == FPDF_ANNOT_LINE) ? "CO" : "BentoCO";
+  auto arr = pdfium::MakeRetain<CPDF_Array>();
+  arr->AppendNew<CPDF_Number>(dx);
+  arr->AppendNew<CPDF_Number>(dy);
+  dict->SetFor(key, std::move(arr));
+  return true;
+}
+
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+EPDFAnnot_GetCaptionOffset(FPDF_ANNOTATION annot, float* dx, float* dy) {
+  if (!annot || !dx || !dy) return false;
+  const CPDF_Dictionary* dict = GetAnnotDictFromFPDFAnnotation(annot);
+  if (!dict) return false;
+
+  RetainPtr<const CPDF_Array> arr = dict->GetArrayFor("CO");
+  if (!arr) arr = dict->GetArrayFor("BentoCO");
+  if (!arr || arr->size() < 2) return false;
+  *dx = arr->GetFloatAt(0);
+  *dy = arr->GetFloatAt(1);
+  return true;
+}
+
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+EPDFAnnot_GenerateMeasurementAppearance(FPDF_ANNOTATION annot,
+                                        const char* ,
+                                        float ) {
+  if (!annot) return false;
+  RetainPtr<CPDF_Dictionary> annot_dict =
+      GetMutableAnnotDictFromFPDFAnnotation(annot);
+  if (!annot_dict) return false;
+  annot_dict->RemoveFor("AP");
+  annot_dict->RemoveFor("AS");
+  annot_dict->RemoveFor("PDFiumHasGeneratedAP");
+  return true;
+}
