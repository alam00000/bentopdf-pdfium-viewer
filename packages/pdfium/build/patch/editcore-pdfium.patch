+RetainPtr<CPDF_Dictionary> BuildRectilinearMeasure(
+    const char* scale_ratio_utf8,
+    const EPDFNumberFormat* x_arr,
+    int x_count,
+    const EPDFNumberFormat* y_arr,
+    int y_count,
+    const EPDFNumberFormat* d_arr,
+    int d_count,
+    const EPDFNumberFormat* a_arr,
+    int a_count,
+    float cyx) {
+  auto measure = pdfium::MakeRetain<CPDF_Dictionary>();
+  measure->SetNewFor<CPDF_Name>("Type", "Measure");
+  measure->SetNewFor<CPDF_Name>("Subtype", "RL");
+
+  if (scale_ratio_utf8 && *scale_ratio_utf8) {
+    WideString r = WideString::FromUTF8(ByteStringView(scale_ratio_utf8));
+    measure->SetNewFor<CPDF_String>("R", r.AsStringView());
+  }
+
+  AppendNumberFormatArray(measure.Get(), "X", x_arr, x_count);
+  if (y_count > 0) {
+    AppendNumberFormatArray(measure.Get(), "Y", y_arr, y_count);
+  }
+  AppendNumberFormatArray(measure.Get(), "D", d_arr, d_count);
+  AppendNumberFormatArray(measure.Get(), "A", a_arr, a_count);
+
+  if (cyx > 0 && std::isfinite(cyx) && (y_count > 0 || cyx != 1.0f)) {
+    measure->SetNewFor<CPDF_Number>("CYX", cyx);
+  }
+  return measure;
+}
+
+ByteString MeasureDictJson(const CPDF_Dictionary* measure) {
+  fxcrt::ostringstream out;
+  out << "{";
+  bool first = true;
+  auto next = [&]() {
+    if (!first) out << ",";
+    first = false;
+  };
+
+  RetainPtr<const CPDF_Object> r_obj = measure->GetDirectObjectFor("R");
+  if (r_obj && r_obj->IsString()) {
+    next();
+    out << "\"R\":" << JsonEscape(measure->GetUnicodeTextFor("R").ToUTF8());
+  }
+  RetainPtr<const CPDF_Object> cyx_obj = measure->GetDirectObjectFor("CYX");
+  if (cyx_obj && cyx_obj->IsNumber()) {
+    next();
+    const float cyx = cyx_obj->GetNumber();
+    out << "\"CYX\":" << (std::isfinite(cyx) ? cyx : 1.0f);
+  }
+  ByteString subtype = measure->GetNameFor("Subtype");
+  if (!subtype.IsEmpty()) {
+    next();
+    out << "\"Subtype\":" << JsonEscape(subtype);
+  }
+  RetainPtr<const CPDF_Array> origin = measure->GetArrayFor("O");
+  if (origin && origin->size() == 2) {
+    next();
+    const float ox = origin->GetFloatAt(0);
+    const float oy = origin->GetFloatAt(1);
+    out << "\"O\":[" << (std::isfinite(ox) ? ox : 0.0f) << ","
+        << (std::isfinite(oy) ? oy : 0.0f) << "]";
+  }
+  for (const char* key : {"X", "Y", "D", "A"}) {
+    if (!measure->GetArrayFor(key)) continue;
+    next();
+    out << "\"" << key << "\":";
+    NumberFormatArrayToJson(measure, key, out);
+  }
+  out << "}";
+  return ByteString(out);
+}
