+void AppendNumberFormatArray(CPDF_Dictionary* measure_dict,
+                             const char* key,
+                             const EPDFNumberFormat* arr,
+                             int count) {
+  if (count <= 0 || !arr) {
+    return;
+  }
+  auto out_array = pdfium::MakeRetain<CPDF_Array>();
+  for (int i = 0; i < count; ++i) {
+    out_array->Append(BuildNumberFormatDict(arr[i]));
+  }
+  measure_dict->SetFor(key, std::move(out_array));
+}
+
+ByteString JsonEscape(const ByteString& s) {
+  fxcrt::ostringstream out;
+  out << '"';
+  for (size_t i = 0; i < s.GetLength(); ++i) {
+    const unsigned char c = static_cast<unsigned char>(s[i]);
+    switch (c) {
+      case '"':  out << "\\\""; break;
+      case '\\': out << "\\\\"; break;
+      case '\b': out << "\\b";  break;
+      case '\f': out << "\\f";  break;
+      case '\n': out << "\\n";  break;
+      case '\r': out << "\\r";  break;
+      case '\t': out << "\\t";  break;
+      default:
+        if (c < 0x20) {
+          char buf[8];
+          snprintf(buf, sizeof(buf), "\\u%04x", c);
+          out << buf;
+        } else {
+          out << static_cast<char>(c);
+        }
+        break;
+    }
+  }
+  out << '"';
+  return ByteString(out);
+}
+
+void NumberFormatToJson(const CPDF_Dictionary* nf, fxcrt::ostringstream& out) {
+  out << "{";
+  bool first = true;
+  auto emit_str = [&](const char* key, const ByteString& val) {
+    if (!first) out << ",";
+    first = false;
+    out << "\"" << key << "\":" << JsonEscape(val);
+  };
+  auto emit_num = [&](const char* key, double val) {
+    if (!first) out << ",";
+    first = false;
+    out << "\"" << key << "\":" << (std::isfinite(val) ? val : 0.0);
+  };
+  auto emit_bool = [&](const char* key, bool val) {
+    if (!first) out << ",";
+    first = false;
+    out << "\"" << key << "\":" << (val ? "true" : "false");
+  };
+
+  emit_str("U", nf->GetUnicodeTextFor("U").ToUTF8());
+  emit_num("C", nf->GetFloatFor("C"));
+  ByteString F = nf->GetNameFor("F");
+  if (F.IsEmpty()) F = "D";
+  emit_str("F", F);
+  emit_num("D", nf->GetIntegerFor("D"));
+  emit_bool("FD", nf->GetBooleanFor("FD", false));
+
+  RetainPtr<const CPDF_Object> rt_obj = nf->GetObjectFor("RT");
+  if (rt_obj && rt_obj->IsString())
+    emit_str("RT", rt_obj->GetString());
+  RetainPtr<const CPDF_Object> rd_obj = nf->GetObjectFor("RD");
+  if (rd_obj && rd_obj->IsString())
+    emit_str("RD", rd_obj->GetString());
+  RetainPtr<const CPDF_Object> ps_obj = nf->GetObjectFor("PS");
+  if (ps_obj && ps_obj->IsString())
+    emit_str("PS", ps_obj->GetString());
+  RetainPtr<const CPDF_Object> ss_obj = nf->GetObjectFor("SS");
+  if (ss_obj && ss_obj->IsString())
+    emit_str("SS", ss_obj->GetString());
+
+  ByteString O = nf->GetNameFor("O");
+  if (!O.IsEmpty()) emit_str("O", O);
+  out << "}";
+}
+
+void NumberFormatArrayToJson(const CPDF_Dictionary* measure_dict,
+                             const char* key,
+                             fxcrt::ostringstream& out) {
+  out << "[";
+  RetainPtr<const CPDF_Array> arr = measure_dict->GetArrayFor(key);
+  if (arr) {
+    for (size_t i = 0; i < arr->size(); ++i) {
+      if (i > 0) out << ",";
+      RetainPtr<const CPDF_Dictionary> nf = arr->GetDictAt(i);
+      if (nf) {
+        NumberFormatToJson(nf.Get(), out);
+      } else {
+        out << "null";
+      }
+    }
+  }
+  out << "]";
+}
