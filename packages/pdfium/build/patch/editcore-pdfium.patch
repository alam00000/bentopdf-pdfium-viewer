+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+EPDFAnnot_SetExtendedRotation(FPDF_ANNOTATION annot, float rotation) {
+  if (!CPDFAnnotContextFromFPDFAnnotation(annot)) {
+    return false;
+  }
+  if (rotation == 0.0f) {
+    EPDFAnnot_ClearEmbedMetadataKey(annot, "Rotation");
+    return true;
+  }
+  return EPDFAnnot_SetEmbedMetadataNumber(annot, "Rotation", rotation);
+}
+
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+EPDFAnnot_GetExtendedRotation(FPDF_ANNOTATION annot, float* rotation) {
+  if (!rotation || !CPDFAnnotContextFromFPDFAnnotation(annot)) {
+    return false;
+  }
+  *rotation = 0.0f;
+  EPDFAnnot_GetEmbedMetadataNumber(annot, "Rotation", rotation);
+  return true;
+}
+
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+EPDFAnnot_SetUnrotatedRect(FPDF_ANNOTATION annot, const FS_RECTF* rect) {
+  if (!CPDFAnnotContextFromFPDFAnnotation(annot)) {
+    return false;
+  }
+  if (!rect || CFXFloatRectFromFSRectF(*rect).IsEmpty()) {
+    EPDFAnnot_ClearEmbedMetadataKey(annot, "UnrotatedRect");
+    return true;
+  }
+  return EPDFAnnot_SetEmbedMetadataRect(annot, "UnrotatedRect", rect);
+}
+
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+EPDFAnnot_GetUnrotatedRect(FPDF_ANNOTATION annot, FS_RECTF* rect) {
+  if (!rect || !CPDFAnnotContextFromFPDFAnnotation(annot)) {
+    return false;
+  }
+  *rect = FSRectFFromCFXFloatRect(CFX_FloatRect());
+  EPDFAnnot_GetEmbedMetadataRect(annot, "UnrotatedRect", rect);
+  return true;
+}
