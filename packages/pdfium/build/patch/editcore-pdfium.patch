+int MeasurementCaptionPageQuarter(const CPDF_Dictionary* annot_dict) {
+  if (annot_dict->KeyExist("EPDFPageRot"))
+    return ((annot_dict->GetIntegerFor("EPDFPageRot") % 4) + 4) % 4;
+  RetainPtr<const CPDF_Dictionary> node = annot_dict->GetDictFor("P");
+  for (int depth = 0; node && depth < 32; ++depth) {
+    RetainPtr<const CPDF_Object> rotate = node->GetDirectObjectFor("Rotate");
+    if (rotate) {
+      const int quarter = rotate->GetInteger() / 90;
+      return ((quarter % 4) + 4) % 4;
+    }
+    node = node->GetDictFor("Parent");
+  }
+  return 0;
+}
+
+bool MaybeAddMeasurementCaption(fxcrt::ostringstream& ap,
+                                       const CPDF_Dictionary* annot_dict,
+                                       float anchor_x,
+                                       float anchor_y) {
+  ByteString intent = annot_dict->GetByteStringFor("IT");
+  if (intent != "LineDimension" && intent != "PolyLineDimension" &&
+      intent != "PolygonDimension") {
+    return false;
+  }
+  WideString contents_w = annot_dict->GetUnicodeTextFor("Contents");
+  if (contents_w.IsEmpty()) return false;
+
+  fxcrt::ostringstream esc;
+  for (size_t i = 0; i < contents_w.GetLength(); ++i) {
+    wchar_t wc = contents_w[i];
+    if (wc < 0x20 || wc >= 0x100) {
+      continue;
+    }
+    unsigned char c = static_cast<unsigned char>(wc);
+    if (c == '(' || c == ')' || c == '\\') {
+      esc << '\\' << static_cast<char>(c);
+    } else if (c < 0x7F) {
+      esc << static_cast<char>(c);
+    } else {
+      char buf[8];
+      snprintf(buf, sizeof(buf), "\\%03o", c);
+      esc << buf;
+    }
+  }
+  ByteString esc_str(esc);
+  if (esc_str.IsEmpty()) return false;
+
+  const float font_size = 11.0f;
+  const float text_w = contents_w.GetLength() * font_size * 0.55f;
+
+  const float text_x = anchor_x - text_w * 0.5f;
+  const float text_y = anchor_y - font_size * 0.35f;
+
+  const int page_quarter = MeasurementCaptionPageQuarter(annot_dict);
+  const float off_x = text_x - anchor_x;
+  const float off_y = text_y - anchor_y;
+  float m_a = 1, m_b = 0, m_c = 0, m_d = 1;
+  float rot_off_x = off_x, rot_off_y = off_y;
+  switch (page_quarter) {
+    case 1:
+      m_a = 0; m_b = 1; m_c = -1; m_d = 0;
+      rot_off_x = -off_y; rot_off_y = off_x;
+      break;
+    case 2:
+      m_a = -1; m_b = 0; m_c = 0; m_d = -1;
+      rot_off_x = -off_x; rot_off_y = -off_y;
+      break;
+    case 3:
+      m_a = 0; m_b = -1; m_c = 1; m_d = 0;
+      rot_off_x = off_y; rot_off_y = -off_x;
+      break;
+    default:
+      break;
+  }
+
+  ap << "q\n";
+  ap << "0 0 0 rg\n";
+  if (page_quarter == 0) {
+    ap << "BT /F1 " << font_size << " Tf "
+       << text_x << " " << text_y << " Td ("
+       << ByteString(esc_str).c_str() << ") Tj ET\n";
+  } else {
+    ap << "BT /F1 " << font_size << " Tf " << m_a << " " << m_b << " "
+       << m_c << " " << m_d << " " << (anchor_x + rot_off_x) << " "
+       << (anchor_y + rot_off_y) << " Tm ("
+       << ByteString(esc_str).c_str() << ") Tj ET\n";
+  }
+  ap << "Q\n";
+  return true;
+}
