+RetainPtr<CPDF_Dictionary> BuildNumberFormatDict(
+    const EPDFNumberFormat& nf) {
+  auto dict = pdfium::MakeRetain<CPDF_Dictionary>();
+  dict->SetNewFor<CPDF_Name>("Type", "NumberFormat");
+  if (nf.unit_utf8 && *nf.unit_utf8) {
+    WideString u_wide = WideString::FromUTF8(ByteStringView(nf.unit_utf8));
+    dict->SetNewFor<CPDF_String>("U", u_wide.AsStringView());
+  } else {
+    dict->SetNewFor<CPDF_String>("U", ByteString());
+  }
+  float conv = static_cast<float>(nf.conversion);
+  if (!std::isfinite(conv)) conv = 0.0f;
+  dict->SetNewFor<CPDF_Number>("C", conv);
+
+  char f = nf.format;
+  if (f != 'D' && f != 'F' && f != 'R' && f != 'T') {
+    f = 'D';
+  }
+  char f_str[2] = {f, 0};
+  dict->SetNewFor<CPDF_Name>("F", ByteString(f_str));
+
+  if (nf.precision > 0) {
+    dict->SetNewFor<CPDF_Number>("D", nf.precision);
+  }
+
+  if (nf.force_exact) {
+    dict->SetNewFor<CPDF_Boolean>("FD", true);
+  }
+
+  if (nf.thousands_sep) {
+    dict->SetNewFor<CPDF_String>("RT", ByteString(nf.thousands_sep));
+  }
+  if (nf.decimal_sep) {
+    dict->SetNewFor<CPDF_String>("RD", ByteString(nf.decimal_sep));
+  }
+  if (nf.prefix) {
+    dict->SetNewFor<CPDF_String>("PS", ByteString(nf.prefix));
+  }
+  if (nf.suffix) {
+    dict->SetNewFor<CPDF_String>("SS", ByteString(nf.suffix));
+  }
+
+  if (nf.order == 'P') {
+    dict->SetNewFor<CPDF_Name>("O", "P");
+  } else if (nf.order == 'S') {
+    dict->SetNewFor<CPDF_Name>("O", "S");
+  }
+
+  return dict;
+}
