+RetainPtr<CPDF_Dictionary> BuildHelveticaResourceFontDict(
+    APGenerationTarget* target) {
+  CPDF_Document* doc = target->doc;
+  RetainPtr<CPDF_Dictionary> helv =
+      target->IsPersistent() ? doc->NewIndirect<CPDF_Dictionary>()
+                             : pdfium::MakeRetain<CPDF_Dictionary>();
+  helv->SetNewFor<CPDF_Name>("Type", "Font");
+  helv->SetNewFor<CPDF_Name>("Subtype", "Type1");
+  helv->SetNewFor<CPDF_Name>("BaseFont", "Helvetica");
+  helv->SetNewFor<CPDF_Name>("Encoding",
+                             pdfium::font_encodings::kWinAnsiEncoding);
+  auto font_res = doc->New<CPDF_Dictionary>();
+  if (target->IsPersistent()) {
+    font_res->SetNewFor<CPDF_Reference>("F1", doc, helv->GetObjNum());
+  } else {
+    font_res->SetFor("F1", std::move(helv));
+  }
+  return font_res;
+}
